# Production PostgreSQL Configuration (use with prisma/schema.postgres.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/typefully_prod?schema=public"
NEXTAUTH_URL="https://app.typefully.local"
NEXTAUTH_SECRET="replace-with-production-nextauth-secret"
NEXT_PUBLIC_APP_URL="https://app.typefully.local"
ACCOUNT_ADMISSION_MODE="invitation-only"
